PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/fidelidade.db

# Produção: defina senhas fortes e STRICT_SECRETS=1 (ou NODE_ENV=production)
# ADMIN_PASSWORD pode ser texto ou hash bcrypt ($2a$... / $2b$...)
ADMIN_PASSWORD=admin123
JWT_SECRET=troque-este-segredo-em-producao
STATION_SHARED_SECRET=loja-geek-station-secret
# STRICT_SECRETS=1
# IPv4 público da loja (opcional). Vazio = a API descobre sozinha de 10 em 10 min.
# STORE_PUBLIC_IP=

FACE_SERVICE_URL=http://127.0.0.1:8100
# Mesmo valor no face-service (export FACE_SERVICE_TOKEN=...)
# FACE_SERVICE_TOKEN=
FACE_MATCH_THRESHOLD=0.38
POINTS_PER_REAL=1

# Portal Vercel (CORS). Vazio = aberto (só dev).
# PORTAL_ORIGIN=https://loja-geek-portal.vercel.app

# Compras no portal (horas/assinatura). Default off — só liga com =1
# PORTAL_CHECKOUT_ENABLED=0

# Demonstração MP (Pix + Checkout Pro) sem creditar horas — exige MP_ACCESS_TOKEN TEST-
# PORTAL_PAYMENT_DEMO=1
# PORTAL_PUBLIC_URL=https://loja-geek-portal.vercel.app

# Mercado Pago Pix (sem token = checkout stub; só usado se PORTAL_CHECKOUT_ENABLED=1)
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRET=

# Túnel nomeado
# CLOUDFLARED_TUNNEL_NAME=loja-geek-api
# PUBLIC_API_URL=https://api.seudominio.com

# Sentry (opcional — sem DSN = desligado)
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENV=production
# Portal (Vercel): VITE_SENTRY_DSN=...

# Web Push (VAPID) — gerar: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@seudominio.com

# WhatsApp automático (Evolution API) — ver docs/whatsapp-evolution.md
# WHATSAPP_API_URL=https://sua-evolution:8080
# WHATSAPP_API_KEY=
# WHATSAPP_INSTANCE=loja-geek

# Senha do ajudante de balcão (modo só leitura / caixa — sem Config)
# CLERK_PASSWORD=senha-balcao
