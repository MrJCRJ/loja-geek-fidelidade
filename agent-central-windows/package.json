{
  "name": "geekcentral",
  "private": true,
  "version": "1.0.0",
  "description": "GeekCentral — servidor + admin VIP no PC controle Windows",
  "main": "electron/main.cjs",
  "author": "Loja Geek",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5175 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 GEEKCENTRAL_DEV=1 electron .\"",
    "build:web": "vite build",
    "build": "vite build && electron-builder --win dir --x64",
    "build:nsis": "vite build && electron-builder --win nsis --x64",
    "pack:pendrive": "bash ../scripts/pack-pendrive-central.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "br.lojageek.geekcentral",
    "productName": "GeekCentral",
    "icon": "../portal/public/brand/icon-256.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../portal/public/brand/icon-256.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrJCRJ",
        "repo": "loja-geek-fidelidade"
      }
    ]
  }
}
